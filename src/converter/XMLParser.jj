options {
    STATIC = false;
    LOOKAHEAD = 2;
    CHOICE_AMBIGUITY_CHECK = 2;
    OTHER_AMBIGUITY_CHECK = 1;
    DEBUG_PARSER = true;  // Activer le débogage du parseur
    DEBUG_LOOKAHEAD = true;  // Activer le débogage du lookahead
    DEBUG_TOKEN_MANAGER = true;  // Activer le débogage du gestionnaire de tokens
    ERROR_REPORTING = true;
    JAVA_UNICODE_ESCAPE = false;
    UNICODE_INPUT = false;
    IGNORE_CASE = false;
    USER_TOKEN_MANAGER = false;
    USER_CHAR_STREAM = false;
    BUILD_PARSER = true;
    BUILD_TOKEN_MANAGER = true;
    FORCE_LA_CHECK = true;
}

PARSER_BEGIN(XMLParser)
package converter;

import java.io.*;
import java.util.*;

public class XMLParser {
    private StringBuilder jsonOutput = new StringBuilder();
    private int indentLevel = 0;
    private Stack<String> tagStack = new Stack<>();
    private boolean isFirstElement = true;
    private boolean hasContent = false;

    public String getJsonOutput() {
        return jsonOutput.toString();
    }

    private void addIndent() {
        for (int i = 0; i < indentLevel; i++) {
            jsonOutput.append("  ");
        }
    }

    private void startObject(String name) {
        if (!isFirstElement) {
            jsonOutput.append(",\n");
        }
        addIndent();
        jsonOutput.append("\"").append(escapeJson(name)).append("\": {");
        indentLevel++;
        isFirstElement = true;
        hasContent = false;
    }

    private void endObject() {
        indentLevel--;
        jsonOutput.append("\n");
        addIndent();
        jsonOutput.append("}");
        isFirstElement = false;
    }

    private void addAttribute(String name, String value) {
    if (!isFirstElement) {
        jsonOutput.append(",\n");
    }
    addIndent();
    jsonOutput.append("\"").append(escapeJson(name)).append("\": ")
            .append("\"").append(escapeJson(value)).append("\"");
    isFirstElement = false;
}
    
    private void addSimpleElement(String name, String text) {
        if (!isFirstElement) {
            jsonOutput.append(",\n");
        }
        addIndent();
        jsonOutput.append("\"").append(escapeJson(name)).append("\": \"")
                .append(escapeJson(text)).append("\"");
        isFirstElement = false;
    }

    private void addText(String text) {
        String trimmedText = text.trim();
        if (trimmedText.isEmpty()) {
            return;
        }
        if (!isFirstElement) {
            jsonOutput.append(",\n");
        }
        addIndent();
        jsonOutput.append("\"#text\": \"").append(escapeJson(trimmedText)).append("\"");
        isFirstElement = false;
        hasContent = true;
    }

    private String escapeJson(String input) {
        return input.replace("\\", "\\\\")
                   .replace("\"", "\\\"")
                   .replace("\b", "\\b")
                   .replace("\f", "\\f")
                   .replace("\n", "\\n")
                   .replace("\r", "\\r")
                   .replace("\t", "\\t");
    }

    public static XMLParser createParser(String xmlContent) {
        return new XMLParser(new StringReader(xmlContent));
    }

    public static XMLParser createParser(File xmlFile) throws FileNotFoundException {
        return new XMLParser(new FileReader(xmlFile));
    }
}
PARSER_END(XMLParser)

SKIP : {
    " "
    | "\t"
    | "\n"
    | "\r"
    | < XML_COMMENT: "<!--" (~["-"])* "-->" >  
}

TOKEN : {
    < XML_DECLARATION: "<?xml" (~["?"])* "?>" > 
    | < OPEN_TAG: "<" >
    | < CLOSE_TAG: ">" >
    | < END_TAG: "</" >
    | < SELF_CLOSE: "/>" >
    | < EQUALS: "=" >
    | < NAME: (["a"-"z", "A"-"Z", "_", ":"])(["a"-"z", "A"-"Z", "0"-"9", "_", "-", ":", "."])* >
    | < ATTRIBUTE_VALUE: "\"" (~["\""])* "\"" >
    | < TEXT: (~["<", ">", "\n", "\r"])+ >  // Modification de la définition du TEXT token
}

void document() : {
    jsonOutput.setLength(0);
    indentLevel = 0;
    isFirstElement = true;
    jsonOutput.append("{\n");
}
{
    [declaration()]
    element()
    <EOF>
    {
        jsonOutput.append("\n}");
    }
}

void declaration() : {}
{
    <XML_DECLARATION>
}


void content() : {
    Token t;
}
{
    (
        LOOKAHEAD(2)
        element()
        |
        t = <TEXT> {
            String text = t.image.trim();
            if (!text.isEmpty()) {
                addText(text);
            }
        }
    )*  // Ajout de l'étoile ici pour permettre 0 ou plusieurs occurrences
}

// Modification de la règle element() pour mieux gérer la structure
void element() : {
    Token t;
    String elementName;
}
{
    <OPEN_TAG>
    t = <NAME> {
        elementName = t.image;
        tagStack.push(elementName);
        startObject(elementName);
    }
    
    (attribute())*
    
    (
        <SELF_CLOSE> {
            tagStack.pop();
            endObject();
        }
        |
        <CLOSE_TAG>
        content()  // Suppression du LOOKAHEAD et du + ici
        <END_TAG>
        t = <NAME> {
            if (!elementName.equals(t.image)) {
                throw new ParseException("Mismatched tags: opening tag was " + 
                    elementName + " but closing tag is " + t.image);
            }
            tagStack.pop();
            endObject();
        }
        <CLOSE_TAG>
    )
}

void attribute() : {
    Token nameToken;
    Token valueToken;
}
{
    nameToken = <NAME>
    <EQUALS>
    valueToken = <ATTRIBUTE_VALUE>
    {
        String value = valueToken.image.substring(1, valueToken.image.length() - 1);
        addAttribute(nameToken.image, value);
    }
}

